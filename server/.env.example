const PORT = process.env.PORT || 5000;
NODE_ENV=development

# MongoDB (local hoặc MongoDB Atlas free tier)
MONGO_URI=mongodb://localhost:27017/khanhhuyen

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - URL của client (Vite dev mặc định 5173)
CLIENT_URL=http://localhost:5173

# Cloudinary (lấy tại https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tài khoản admin khởi tạo (dùng khi chạy `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
