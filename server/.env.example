PORT=5000
NODE_ENV=development

# MongoDB (local hoặc MongoDB Atlas free tier)
MONGO_URI=mongodb://localhost:27017/khanhhuyen

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - URL của client (Vite dev mặc định 5173; production: https://www.cohuyentiengtrung.blog, không có / cuối)
CLIENT_URL=http://localhost:5173

# Cloudinary (lấy tại https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Tài khoản admin khởi tạo (dùng khi chạy `npm run seed` hoặc `node src/seed/resetAdmin.js`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
